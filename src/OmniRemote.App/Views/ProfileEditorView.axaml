<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniRemote.App.ViewModels"
             x:Class="OmniRemote.App.Views.ProfileEditorView"
             x:DataType="vm:ProfileEditorViewModel"
             Background="#1E1E2E">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="28,24">

            <!-- Header -->
            <TextBlock Text="{Binding Loc.ConnectionProfileTitle}"
                       FontSize="20" FontWeight="SemiBold" Foreground="#CDD6F4"/>

            <!-- Protocol -->
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Loc.ProtocolLabel}" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding AvailableProtocols}"
                          SelectedItem="{Binding Protocol}"
                          HorizontalAlignment="Stretch"
                          Background="#313244" Foreground="#CDD6F4"
                          BorderBrush="#45475A" BorderThickness="1" CornerRadius="4"/>
            </StackPanel>

            <!-- Name -->
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Loc.NameLabel}" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Name}"
                         PlaceholderText="{Binding Loc.NameEditorPlaceholder}"
                         Background="#313244" Foreground="#CDD6F4"
                         BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Padding="8,6"/>
            </StackPanel>

            <!-- Host + Port -->
            <Grid ColumnDefinitions="*,96" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding Loc.HostLabel}" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Host}"
                             PlaceholderText="{Binding Loc.HostEditorPlaceholder}"
                             Background="#313244" Foreground="#CDD6F4"
                             BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Padding="8,6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding Loc.PortLabel}" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>
                    <NumericUpDown Value="{Binding Port}"
                                   Minimum="1" Maximum="65535" FormatString="0"
                                   Background="#313244" Foreground="#CDD6F4"
                                   BorderBrush="#45475A" BorderThickness="1" CornerRadius="4"/>
                </StackPanel>
            </Grid>

            <!-- Username (hidden for Telnet) -->
            <StackPanel Spacing="4" IsVisible="{Binding IsUsernameRequired}">
                <TextBlock Text="{Binding Loc.UsernameLabel}" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Username}"
                         PlaceholderText="{Binding Loc.UsernameEditorPlaceholder}"
                         Background="#313244" Foreground="#CDD6F4"
                         BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Padding="8,6"/>
            </StackPanel>

            <!-- Password (hidden for Telnet) -->
            <StackPanel Spacing="4" IsVisible="{Binding IsPasswordVisible}">
                <TextBlock Text="{Binding Loc.PasswordLabel}" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Password}" PasswordChar="*"
                         PlaceholderText="{Binding Loc.PasswordEditorPlaceholder}"
                         Background="#313244" Foreground="#CDD6F4"
                         BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Padding="8,6"/>
                <CheckBox Content="{Binding Loc.RememberPassword}"
                          IsChecked="{Binding RememberPassword}" Foreground="#CDD6F4"/>
                <TextBlock Text="{Binding Loc.PasswordAlreadySaved}"
                           Foreground="#A6E3A1" FontSize="11"
                           IsVisible="{Binding HasSavedPassword}"/>
            </StackPanel>

            <!-- Description -->
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding Loc.DescriptionLabel}" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Description}"
                         PlaceholderText="{Binding Loc.DescriptionPlaceholder}"
                         Background="#313244" Foreground="#CDD6F4"
                         BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Padding="8,6"/>
            </StackPanel>

            <!-- RDP Display Settings -->
            <StackPanel Spacing="8" IsVisible="{Binding IsRdpDisplayVisible}">
                <TextBlock Text="{Binding Loc.RdpDisplayLabel}"
                           Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>

                <CheckBox Content="{Binding Loc.RdpFullscreenLabel}"
                          IsChecked="{Binding RdpFullscreen}"
                          Foreground="#CDD6F4"/>

                <!-- Resolution picker (hidden when fullscreen) -->
                <StackPanel Spacing="6" IsVisible="{Binding IsRdpResolutionVisible}">
                    <TextBlock Text="{Binding Loc.RdpResolutionLabel}"
                               Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding RdpPresets}"
                              SelectedItem="{Binding SelectedRdpPreset}"
                              Background="#313244" Foreground="#CDD6F4"
                              BorderBrush="#45475A" BorderThickness="1" CornerRadius="4"
                              HorizontalAlignment="Stretch"/>

                    <!-- Custom resolution inputs -->
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8"
                          IsVisible="{Binding IsRdpCustomResolutionVisible}">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding Loc.RdpWidthLabel}"
                                       Foreground="#6C7086" FontSize="11"/>
                            <NumericUpDown Value="{Binding RdpDesktopWidth}"
                                           Minimum="640" Maximum="7680" FormatString="0"
                                           Background="#313244" Foreground="#CDD6F4"
                                           BorderBrush="#45475A" BorderThickness="1" CornerRadius="4"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="×" Foreground="#6C7086"
                                   VerticalAlignment="Bottom" Margin="0,0,0,6" FontSize="14"/>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="{Binding Loc.RdpHeightLabel}"
                                       Foreground="#6C7086" FontSize="11"/>
                            <NumericUpDown Value="{Binding RdpDesktopHeight}"
                                           Minimum="480" Maximum="4320" FormatString="0"
                                           Background="#313244" Foreground="#CDD6F4"
                                           BorderBrush="#45475A" BorderThickness="1" CornerRadius="4"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!-- Divider -->
            <Border Height="1" Background="#313244" Margin="0,4"/>

            <!-- TLS Certificate Bypass (RDP only) -->
            <StackPanel Spacing="8" IsVisible="{Binding IsBypassCertSettingVisible}">
                <TextBlock Text="{Binding Loc.SecurityLabel}" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>

                <CheckBox Content="{Binding Loc.BypassTlsCert}"
                          IsChecked="{Binding BypassCertificateValidation}"
                          Foreground="#CDD6F4"/>

                <!-- Active bypass indicator -->
                <Border Background="#3B2A00" CornerRadius="4" Padding="10,6"
                        IsVisible="{Binding BypassCertificateValidation}">
                    <TextBlock Text="{Binding Loc.TlsDisabledWarning}"
                               Foreground="#F9E2AF" FontSize="12"/>
                </Border>

                <!-- Confirmation panel (shown instead of immediately enabling) -->
                <Border Background="#2D1B1B" CornerRadius="4" Padding="12"
                        BorderBrush="#F38BA8" BorderThickness="1"
                        IsVisible="{Binding IsBypassCertConfirmationVisible}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Loc.WarningHeader}"
                                   Foreground="#F38BA8" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Loc.TlsWarningDetail}"
                                   Foreground="#F38BA8" TextWrapping="Wrap" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding Loc.ConfirmDisableTls}"
                                    Command="{Binding ConfirmBypassCertCommand}"
                                    Background="#F38BA8" Foreground="#1E1E2E"
                                    FontWeight="SemiBold" CornerRadius="4" Padding="10,6"/>
                            <Button Content="{Binding Loc.CancelButton}"
                                    Command="{Binding CancelBypassCertCommand}"
                                    Background="#313244" Foreground="#CDD6F4"
                                    CornerRadius="4" Padding="10,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- SSH / SFTP Host-Key Policy -->
            <StackPanel Spacing="8" IsVisible="{Binding IsHostKeySettingVisible}">
                <TextBlock Text="{Binding Loc.SecurityLabel}" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>

                <CheckBox Content="{Binding Loc.DisableStrictHostKey}"
                          IsChecked="{Binding DisableStrictHostKeyChecking}"
                          Foreground="#CDD6F4"/>

                <!-- Active host-key bypass indicator -->
                <Border Background="#3B2A00" CornerRadius="4" Padding="10,6"
                        IsVisible="{Binding DisableStrictHostKeyChecking}">
                    <TextBlock Text="{Binding Loc.HostKeyDisabledWarning}"
                               Foreground="#F9E2AF" FontSize="12"/>
                </Border>

                <!-- Confirmation panel -->
                <Border Background="#2D1B1B" CornerRadius="4" Padding="12"
                        BorderBrush="#F38BA8" BorderThickness="1"
                        IsVisible="{Binding IsHostKeyConfirmationVisible}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding Loc.WarningHeader}"
                                   Foreground="#F38BA8" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Loc.HostKeyWarningDetail}"
                                   Foreground="#F38BA8" TextWrapping="Wrap" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{Binding Loc.ConfirmDisableHostKey}"
                                    Command="{Binding ConfirmDisableHostKeyCommand}"
                                    Background="#F38BA8" Foreground="#1E1E2E"
                                    FontWeight="SemiBold" CornerRadius="4" Padding="10,6"/>
                            <Button Content="{Binding Loc.CancelButton}"
                                    Command="{Binding CancelDisableHostKeyCommand}"
                                    Background="#313244" Foreground="#CDD6F4"
                                    CornerRadius="4" Padding="10,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Validation error -->
            <TextBlock Text="{Binding ValidationError}"
                       Foreground="#F38BA8" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- Save / Cancel -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8">
                <Button Content="{Binding Loc.CancelButton}"
                        Command="{Binding CancelCommand}"
                        Background="#313244" Foreground="#CDD6F4"
                        CornerRadius="4" Padding="16,8"/>
                <Button Content="{Binding Loc.SaveProfileButton}"
                        Command="{Binding SaveCommand}"
                        Background="#89B4FA" Foreground="#1E1E2E"
                        FontWeight="SemiBold" CornerRadius="4" Padding="16,8"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
