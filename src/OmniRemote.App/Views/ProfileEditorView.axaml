<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OmniRemote.App.ViewModels"
             x:Class="OmniRemote.App.Views.ProfileEditorView"
             x:DataType="vm:ProfileEditorViewModel"
             Background="#1E1E2E">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="28,24">

            <!-- Header -->
            <TextBlock Text="Connection Profile"
                       FontSize="20" FontWeight="SemiBold" Foreground="#CDD6F4"/>

            <!-- Protocol -->
            <StackPanel Spacing="4">
                <TextBlock Text="PROTOCOL" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding AvailableProtocols}"
                          SelectedItem="{Binding Protocol}"
                          HorizontalAlignment="Stretch"
                          Background="#313244" Foreground="#CDD6F4"
                          BorderBrush="#45475A" BorderThickness="1" CornerRadius="4"/>
            </StackPanel>

            <!-- Name -->
            <StackPanel Spacing="4">
                <TextBlock Text="NAME" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Name}"
                         PlaceholderText="e.g. Production Web Server"
                         Background="#313244" Foreground="#CDD6F4"
                         BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Padding="8,6"/>
            </StackPanel>

            <!-- Host + Port -->
            <Grid ColumnDefinitions="*,96" ColumnSpacing="8">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="HOST" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Host}"
                             PlaceholderText="hostname or IP"
                             Background="#313244" Foreground="#CDD6F4"
                             BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Padding="8,6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="PORT" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>
                    <NumericUpDown Value="{Binding Port}"
                                   Minimum="1" Maximum="65535" FormatString="0"
                                   Background="#313244" Foreground="#CDD6F4"
                                   BorderBrush="#45475A" BorderThickness="1" CornerRadius="4"/>
                </StackPanel>
            </Grid>

            <!-- Username (hidden for Telnet) -->
            <StackPanel Spacing="4" IsVisible="{Binding IsUsernameRequired}">
                <TextBlock Text="USERNAME" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Username}"
                         PlaceholderText="username"
                         Background="#313244" Foreground="#CDD6F4"
                         BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Padding="8,6"/>
            </StackPanel>

            <!-- Password (hidden for Telnet) -->
            <StackPanel Spacing="4" IsVisible="{Binding IsPasswordVisible}">
                <TextBlock Text="PASSWORD" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Password}" PasswordChar="*"
                         PlaceholderText="leave empty to keep the saved password"
                         Background="#313244" Foreground="#CDD6F4"
                         BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Padding="8,6"/>
                <CheckBox Content="Remember password (stored in the OS keychain)"
                          IsChecked="{Binding RememberPassword}" Foreground="#CDD6F4"/>
                <TextBlock Text="A password is already saved for this profile."
                           Foreground="#A6E3A1" FontSize="11"
                           IsVisible="{Binding HasSavedPassword}"/>
            </StackPanel>

            <!-- Description -->
            <StackPanel Spacing="4">
                <TextBlock Text="DESCRIPTION (OPTIONAL)" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Description}"
                         PlaceholderText="optional note"
                         Background="#313244" Foreground="#CDD6F4"
                         BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Padding="8,6"/>
            </StackPanel>

            <!-- Divider -->
            <Border Height="1" Background="#313244" Margin="0,4"/>

            <!-- TLS Certificate Bypass (RDP only) -->
            <StackPanel Spacing="8" IsVisible="{Binding IsBypassCertSettingVisible}">
                <TextBlock Text="SECURITY" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>

                <CheckBox Content="Bypass TLS certificate validation"
                          IsChecked="{Binding BypassCertificateValidation}"
                          Foreground="#CDD6F4"/>

                <!-- Active bypass indicator -->
                <Border Background="#3B2A00" CornerRadius="4" Padding="10,6"
                        IsVisible="{Binding BypassCertificateValidation}">
                    <TextBlock Text="⚠  TLS certificate validation is DISABLED for this profile."
                               Foreground="#F9E2AF" FontSize="12"/>
                </Border>

                <!-- Confirmation panel (shown instead of immediately enabling) -->
                <Border Background="#2D1B1B" CornerRadius="4" Padding="12"
                        BorderBrush="#F38BA8" BorderThickness="1"
                        IsVisible="{Binding IsBypassCertConfirmationVisible}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="⚠  WARNING"
                                   Foreground="#F38BA8" FontWeight="SemiBold"/>
                        <TextBlock Text="Disabling TLS certificate validation exposes this connection to man-in-the-middle attacks. The server's identity will NOT be verified. Only use this on isolated, trusted networks."
                                   Foreground="#F38BA8" TextWrapping="Wrap" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="I understand — disable validation"
                                    Command="{Binding ConfirmBypassCertCommand}"
                                    Background="#F38BA8" Foreground="#1E1E2E"
                                    FontWeight="SemiBold" CornerRadius="4" Padding="10,6"/>
                            <Button Content="Cancel"
                                    Command="{Binding CancelBypassCertCommand}"
                                    Background="#313244" Foreground="#CDD6F4"
                                    CornerRadius="4" Padding="10,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- SSH / SFTP Host-Key Policy -->
            <StackPanel Spacing="8" IsVisible="{Binding IsHostKeySettingVisible}">
                <TextBlock Text="SECURITY" Foreground="#6C7086" FontSize="11" FontWeight="SemiBold"/>

                <CheckBox Content="Disable strict host-key checking"
                          IsChecked="{Binding DisableStrictHostKeyChecking}"
                          Foreground="#CDD6F4"/>

                <!-- Active host-key bypass indicator -->
                <Border Background="#3B2A00" CornerRadius="4" Padding="10,6"
                        IsVisible="{Binding DisableStrictHostKeyChecking}">
                    <TextBlock Text="⚠  Strict host-key checking is DISABLED for this profile."
                               Foreground="#F9E2AF" FontSize="12"/>
                </Border>

                <!-- Confirmation panel -->
                <Border Background="#2D1B1B" CornerRadius="4" Padding="12"
                        BorderBrush="#F38BA8" BorderThickness="1"
                        IsVisible="{Binding IsHostKeyConfirmationVisible}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="⚠  WARNING"
                                   Foreground="#F38BA8" FontWeight="SemiBold"/>
                        <TextBlock Text="Disabling strict host-key checking exposes this connection to man-in-the-middle attacks. The server's identity will NOT be verified against known hosts. Only use this when you cannot obtain the correct host key."
                                   Foreground="#F38BA8" TextWrapping="Wrap" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="I understand — disable checking"
                                    Command="{Binding ConfirmDisableHostKeyCommand}"
                                    Background="#F38BA8" Foreground="#1E1E2E"
                                    FontWeight="SemiBold" CornerRadius="4" Padding="10,6"/>
                            <Button Content="Cancel"
                                    Command="{Binding CancelDisableHostKeyCommand}"
                                    Background="#313244" Foreground="#CDD6F4"
                                    CornerRadius="4" Padding="10,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Validation error -->
            <TextBlock Text="{Binding ValidationError}"
                       Foreground="#F38BA8" FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

            <!-- Save / Cancel -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8">
                <Button Content="Cancel"
                        Command="{Binding CancelCommand}"
                        Background="#313244" Foreground="#CDD6F4"
                        CornerRadius="4" Padding="16,8"/>
                <Button Content="Save Profile"
                        Command="{Binding SaveCommand}"
                        Background="#89B4FA" Foreground="#1E1E2E"
                        FontWeight="SemiBold" CornerRadius="4" Padding="16,8"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
